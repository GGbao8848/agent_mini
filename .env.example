# Agent Core configuration (all variables use the AGENT_CORE_ prefix).
# Copy to .env and adjust. Never commit real secrets.

# --- Model ---
AGENT_CORE_MODEL=openai:gpt-4o-mini
AGENT_CORE_MODEL_PROVIDER=openai

# --- Storage (Phase 16: optional SQLite persistence) ---
# When set to a sqlite:/// URL, registries, run/task records, trace events and
# approvals are mirrored to the database and restored after a restart.
# Unset (default) keeps everything in process memory.
# AGENT_CORE_DATABASE_URL=sqlite:///./agent_core.db

# --- MCP ---
# AGENT_CORE_MCP_ENDPOINT=http://localhost:8931/mcp

# --- Runtime ---
AGENT_CORE_ENVIRONMENT=development
AGENT_CORE_LOG_LEVEL=INFO

# --- Outbound proxy (Phase 19: e.g. Telegram; LAN services stay direct) ---
# Applied to HTTP_PROXY / HTTPS_PROXY for the whole process; NO_PROXY always
# exempts localhost and AGENT_CORE_NO_PROXY hosts (local model, txt2img...).
# AGENT_CORE_PROXY_URL=http://127.0.0.1:7890
# AGENT_CORE_NO_PROXY=10.0.0.5,10.0.0.6

# --- Telegram notification channel (Phase 19) ---
# Both required for the telegram_notify builtin tool. Discover TELEGRAM_CHAT_ID
# with: uv run --env-file .env python scripts/smoke_telegram.py
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Model provider API keys are read by the provider SDKs (e.g. OPENAI_API_KEY,
# ANTHROPIC_API_KEY) — never stored in Agent Core code or this file.

# --- Model provider keys (read by provider SDKs, not Agent Core config) ---
# OPENROUTER_API_KEY=sk-or-...

# --- Local OpenAI-compatible LLM (Phase 18: provider 'local') ---
# Any self-hosted endpoint speaking the OpenAI chat API (vLLM, llama.cpp
# server, LMDeploy...). Model spec: local:<model-name>.
# LOCAL_LLM_BASE_URL=http://10.0.0.5:8000/v1
# LOCAL_LLM_API_KEY=optional-if-server-requires-auth

# --- Built-in image tools (Phase 18) ---
# A1111/Forge-compatible txt2img endpoint; when set, the generate_image tool
# is registered (view_image is always registered). Files land in workspace_dir.
# AGENT_CORE_IMAGE_API_BASE_URL=http://10.0.0.6:18542
# AGENT_CORE_WORKSPACE_DIR=./workspace
