# Agent Core configuration (all variables use the AGENT_CORE_ prefix).
# Copy to .env and adjust. Never commit real secrets.

# --- Model ---
AGENT_CORE_MODEL=openai:gpt-4o-mini
AGENT_CORE_MODEL_PROVIDER=openai

# --- Storage (Phase 16: optional SQLite persistence) ---
# When set to a sqlite:/// URL, registries, run/task records, trace events and
# approvals are mirrored to the database and restored after a restart.
# Unset (default) keeps everything in process memory.
# AGENT_CORE_DATABASE_URL=sqlite:///./agent_core.db

# --- MCP ---
# AGENT_CORE_MCP_ENDPOINT=http://localhost:8931/mcp

# --- Runtime ---
AGENT_CORE_ENVIRONMENT=development
AGENT_CORE_LOG_LEVEL=INFO

# --- Outbound proxy (model providers / MCP) ---
# Applied to HTTP_PROXY / HTTPS_PROXY for the whole process.
# AGENT_CORE_PROXY_URL=http://127.0.0.1:7890

# Model provider API keys are read by the provider SDKs (e.g. OPENAI_API_KEY,
# ANTHROPIC_API_KEY) — never stored in Agent Core code or this file.

# --- Model provider keys (read by provider SDKs, not Agent Core config) ---
# OPENROUTER_API_KEY=sk-or-...
